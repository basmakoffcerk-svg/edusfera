# ══════════════════════════════════════════════════════════════════════════════
# edusfera.by — Production Environment
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env.production and fill in the secrets.
# For Docker: DB_HOST=db, REDIS_HOST=redis (service names)
# For bare-metal: DB_HOST=127.0.0.1, REDIS_HOST=127.0.0.1
# ══════════════════════════════════════════════════════════════════════════════

# ─── App ────────────────────────────────────────────────────────────────────
APP_NAME=Edusfera
APP_ENV=production
APP_KEY=                    # Generate: php artisan key:generate
APP_DEBUG=false
APP_URL=https://edusfera.by

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU
APP_TIMEZONE=Europe/Minsk

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# ─── Database ───────────────────────────────────────────────────────────────
# Docker: DB_HOST=db | Bare-metal: DB_HOST=127.0.0.1
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=edusfera
DB_USERNAME=edusfera
DB_PASSWORD=                 # Set a strong password

# ─── Session ────────────────────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=1440
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=.edusfera.by
SESSION_SAME_SITE=lax
SESSION_CONNECTION=default

# ─── Sanctum ────────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=edusfera.by,www.edusfera.by

# ─── Cache / Queue ─────────────────────────────────────────────────────────
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# ─── Redis ──────────────────────────────────────────────────────────────────
# Docker: REDIS_HOST=redis | Bare-metal: REDIS_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=              # Set if Redis requires auth
REDIS_PORT=6379

# ─── Mail ───────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.mail.ru       # Your SMTP host
MAIL_PORT=465
MAIL_USERNAME=               # Your email
MAIL_PASSWORD=               # Your email password / app password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="edusferaby@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Payment Gateway (Alfa-Bank Belarus) ────────────────────────────────────
# Options: alfa | mock | disabled
PAYMENT_GATEWAY=alfa
ALFABANK_USER_NAME=your_alfabank_api_login
ALFABANK_PASSWORD=your_alfabank_api_password
ALFABANK_TOKEN=
ALFABANK_TEST_MODE=false
# Production REST API: https://payment.alfabank.by/payment/rest
# Sandbox REST API:    https://abby.rbsuat.com/payment/rest
ALFABANK_API_URL=https://payment.alfabank.by/payment/rest
ALFABANK_CHECKOUT_URL=https://payment.alfabank.by/payment/rest
ALFABANK_WEB_SDK_URL=https://ecom.alfabank.by/payment/modules/multiframe/main.js
ALFABANK_CURRENCY_CODE=933
ALFABANK_HOLD_PERIOD_DAYS=7
ALFABANK_ALLOWED_IPS=178.163.225.84
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_ALLOWED_IPS=178.163.225.84
PAYMENT_WEBHOOK_REQUIRE_SIGNATURE=true
PAYMENT_WEBHOOK_REQUIRE_IP_ALLOWLIST=true

# ─── NPD (Налог на профессиональный доход) ──────────────────────────────────
NPD_PORTAL_URL=https://npd.nalog.gov.by/npdweb/


# ─── Site Admin ─────────────────────────────────────────────────────────────
SITE_ADMIN_SYNC_ENABLED=false
SITE_ADMIN_NAME="Технический администратор"
SITE_ADMIN_EMAIL=            # Admin email
SITE_ADMIN_PASSWORD=         # Min 16 chars in production

# ─── Payments Logging ──────────────────────────────────────────────────────
PAYMENTS_LOG_PATH=
PAYMENTS_LOG_LEVEL=info

# ─── Frontend ───────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"

# ─── Virtual Classroom ──────────────────────────────────────────────────────
# false - режим доработки (заглушка с перенаправлением на Zoom/Meet), true - штатный WebRTC / LiveKit класс
CLASSROOM_ENABLED=true
# LiveKit Cloud (0 Docker, 10 000 бесплатных минут/мес от livekit.io)
LIVEKIT_HOST=wss://edusfera.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
MEDIA_SERVER_URL=wss://media.edusfera.by
MEDIA_SERVER_INTERNAL_URL=http://localhost:8088
CLASSROOM_JWT_SECRET=        # Generate: openssl rand -hex 32
# Отдельный секрет для внутренних S2S эндпоинтов (whiteboard). НЕ должен
# совпадать с CLASSROOM_JWT_SECRET и НЕ должен быть пустым.
CLASSROOM_INTERNAL_SECRET=   # Generate: openssl rand -hex 32
CLASSROOM_JWT_TTL=3600
CLASSROOM_MAX_FILE_MB=50
CLASSROOM_MAX_ROOM_SIZE=5

# ─── Classroom RS256 Token Issuer ──────────────────────────────────────────
CLASSROOM_TOKEN_ALG=RS256
CLASSROOM_JWT_PRIVATE_KEY_PATH=storage/classroom-private.key
CLASSROOM_JWT_PUBLIC_KEY_PATH=storage/classroom-public.key
CLASSROOM_JWT_GRACE=600
CLASSROOM_JWT_MAX_TTL=7200

# ─── STUN/TURN ─────────────────────────────────────────────────────────────
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER_URL=turn:turn.edusfera.by:3478
TURN_SERVER_USERNAME=        # TURN username
TURN_SERVER_CREDENTIAL=      # TURN password

# ─── Passport / OAuth2 (RS256) ─────────────────────────────────────────────
PASSPORT_PRIVATE_KEY_PATH=storage/oauth-private.key
PASSPORT_PUBLIC_KEY_PATH=storage/oauth-public.key
PASSPORT_PREVIOUS_PUBLIC_KEY_PATH=

# ─── Metrics / Prometheus ──────────────────────────────────────────────────
METRICS_PROTECTION=basic_auth
METRICS_STORAGE=redis
METRICS_BASIC_USER=          # Username for /metrics endpoint
METRICS_BASIC_PASSWORD=      # Password for /metrics endpoint

# ─── Integration Events (EventBus / Outbox) ────────────────────────────────
EVENTS_BUS_DRIVER=redis_streams
EVENTS_TENANT=edusfera
EVENTS_OUTBOX_RETENTION_DAYS=30

# ─── Workspace microservice ────────────────────────────────────────────────
# ОБЯЗАТЕЛЕН: apply-ai-patch endpoint отказывается стартовать без него.
WORKSPACE_INTERNAL_SECRET=   # Generate: openssl rand -hex 32
