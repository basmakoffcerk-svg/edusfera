# ══════════════════════════════════════════════════════════════════════════════
# test.edusfera.by — Staging & WebPAY Audit Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env on your staging server at test.edusfera.by
# ══════════════════════════════════════════════════════════════════════════════

# ─── App ────────────────────────────────────────────────────────────────────
APP_NAME=Edusfera
APP_ENV=staging
APP_KEY=                    # Generate: php artisan key:generate
APP_DEBUG=true              # Set to true on test domain for debugging / audit
APP_URL=https://test.edusfera.by

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU
APP_TIMEZONE=Europe/Minsk

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

# ─── Database ───────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=db                  # Or 127.0.0.1 for bare-metal
DB_PORT=5432
DB_DATABASE=edusfera_test
DB_USERNAME=edusfera
DB_PASSWORD=CHANGE_ME_IN_ENV

# ─── Session & Security ────────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=1440
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=.edusfera.by
SESSION_SAME_SITE=lax

# ─── Sanctum ────────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=test.edusfera.by,edusfera.by

# ─── Cache / Queue / Redis ─────────────────────────────────────────────────
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

# ─── Mail ───────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.mail.ru
MAIL_PORT=465
MAIL_USERNAME=edusferaby@gmail.com
MAIL_PASSWORD=CHANGE_ME_IN_ENV
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="edusferaby@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── WebPAY Split Payments Gateway (Sandbox Mode for Audit) ───────────────
PAYMENT_GATEWAY=webpay
WEBPAY_STORE_ID=192854899
WEBPAY_SECRET_KEY=CHANGE_ME_IN_ENV
WEBPAY_API_USER=edusfera_api_user
WEBPAY_API_PASSWORD=CHANGE_ME_IN_ENV
WEBPAY_TEST_MODE=true
WEBPAY_API_URL=https://apisandbox.webpay.by
WEBPAY_CHECKOUT_URL=https://apisandbox.webpay.by/checkout
WEBPAY_PLATFORM_UNP=192854899
WEBPAY_PLATFORM_COMMISSION_RATE=0.15
WEBPAY_ALLOWED_IPS=178.163.225.84,127.0.0.1

# ─── Site Admin ─────────────────────────────────────────────────────────────
SITE_ADMIN_SYNC_ENABLED=true
SITE_ADMIN_NAME="Технический администратор"
SITE_ADMIN_EMAIL=tech-admin@edusfera.by
SITE_ADMIN_PASSWORD=TechAdmin123!

# ─── Virtual Classroom ──────────────────────────────────────────────────────
MEDIA_SERVER_URL=wss://test.edusfera.by/ws/
MEDIA_SERVER_INTERNAL_URL=http://media:8088
CLASSROOM_JWT_SECRET=super_secret_for_staging_testing_only
CLASSROOM_JWT_TTL=3600
CLASSROOM_MAX_FILE_MB=50
CLASSROOM_MAX_ROOM_SIZE=5

STUN_SERVER=stun:stun.l.google.com:19302
LEDGER_ENABLED=true
LEDGER_URL=http://ledger:8080
