APP_NAME=Edusfera
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU
APP_TIMEZONE=Europe/Minsk

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=edusfera
DB_USERNAME=postgres
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=1440
SESSION_ENCRYPT=true

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@edusfera.by"
MAIL_FROM_NAME="${APP_NAME}"

PAYMENT_GATEWAY=mock
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_ALLOWED_IPS=
PAYMENT_WEBHOOK_REQUIRE_SIGNATURE=false
PAYMENT_WEBHOOK_REQUIRE_IP_ALLOWLIST=false

SITE_ADMIN_SYNC_ENABLED=false
SITE_ADMIN_NAME="Технический администратор"
SITE_ADMIN_EMAIL=tech-admin@example.com
SITE_ADMIN_PASSWORD=

PAYMENTS_LOG_PATH=
PAYMENTS_LOG_LEVEL=info

MULTI_ACCOUNT_AUTO_LINK_ON_LOGIN=false
MULTI_ACCOUNT_REMEMBER_ON_SWITCH=false

VITE_APP_NAME="${APP_NAME}"

# ─── Virtual Classroom ───
MEDIA_SERVER_URL=wss://media.edusfera.by
MEDIA_SERVER_INTERNAL_URL=http://localhost:8088
CLASSROOM_JWT_SECRET=change-me-to-random-64-char-string
CLASSROOM_JWT_TTL=3600
CLASSROOM_MAX_FILE_MB=50
CLASSROOM_MAX_ROOM_SIZE=5

# Classroom RS256 token issuer (требование 11). HS256-fallback — CLASSROOM_JWT_SECRET выше.
# Отдельная от Passport RSA keypair (у classroom собственный kid):
#   openssl genrsa -out storage/classroom-private.key 4096
#   openssl rsa -in storage/classroom-private.key -pubout -out storage/classroom-public.key
CLASSROOM_TOKEN_ALG=RS256
CLASSROOM_JWT_PRIVATE_KEY_PATH=storage/classroom-private.key
CLASSROOM_JWT_PUBLIC_KEY_PATH=storage/classroom-public.key
CLASSROOM_JWT_GRACE=600
CLASSROOM_JWT_MAX_TTL=7200

# STUN/TURN
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER_URL=
TURN_SERVER_USERNAME=
TURN_SERVER_CREDENTIAL=

# ─── Passport / OAuth2 (RS256) ───
# Пути к RSA-ключам для подписи access-токенов (алгоритм RS256).
# Сгенерировать: openssl genrsa -out storage/oauth-private.key 4096
#                openssl rsa -in storage/oauth-private.key -pubout -out storage/oauth-public.key
PASSPORT_PRIVATE_KEY_PATH=storage/oauth-private.key
PASSPORT_PUBLIC_KEY_PATH=storage/oauth-public.key
# Предыдущий публичный ключ — задаётся при ротации для zero-downtime (требование 3.7).
# Оставьте пустым, если ротация не выполняется.
PASSPORT_PREVIOUS_PUBLIC_KEY_PATH=

# ─── Метрики / Prometheus (требование 16) ───
# Способ защиты эндпоинта /metrics: scope | basic_auth
METRICS_PROTECTION=scope
# Storage adapter для агрегации метрик: in_memory | redis | apc
METRICS_STORAGE=in_memory
# Креды для METRICS_PROTECTION=basic_auth
METRICS_BASIC_USER=
METRICS_BASIC_PASSWORD=

# ─── Integration Events (EventBus / Outbox) ───
# Драйвер Event Bus: null (тестовый no-op) | redis_streams (production)
EVENTS_BUS_DRIVER=null
# Tenant-идентификатор в конверте событий
EVENTS_TENANT=edusfera
# Срок хранения опубликованных строк в outbox (дни)
EVENTS_OUTBOX_RETENTION_DAYS=30
