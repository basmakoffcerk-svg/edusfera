# Edusfera Media Server Configuration

# Server port
PORT=8088

# JWT shared secret (must match Laravel app)
JWT_SECRET=your-shared-secret-with-laravel

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=https://edusfera.by,https://app.edusfera.by

# STUN servers for WebRTC ICE (comma-separated)
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Maximum participants per room
MAX_ROOM_SIZE=5

# Room idle timeout in minutes (room is closed after this period with no participants)
ROOM_IDLE_TIMEOUT_MINUTES=120
